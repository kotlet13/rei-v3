    "response_text": "{\n  \"abstains\": false,\n  \"causal_sequence\": [\n    \"Temperature increase and sensor discrepancy create a risk of equipment damage.\",\n    \"Immediate shutdown prevents further heating but triggers a known financial loss.\",\n    \"Continuing production avoids immediate financial loss but maintains the risk of technical damage.\",\n    \"Verification allows for data clarification within the remaining time window before a final decision is required.\"\n  ],\n  \"confidence\": 0.8,\n  \"evidence_ids_used\": [\n    \"factory_ev_temperature\",\n    \"factory_ev_sensor\",\n    \"factory_ev_time\",\n    \"factory_ev_damage\",\n    \"factory_ev_shutdown_loss\"\n  ],\n  \"explicit_goal\": \"Minimize expected technical and financial loss under the three-minute decision boundary while retaining stated uncertainty.\",\n  \"facts_used\": [\n    \"Process temperature rose by 11 C during six minutes.\",\n    \"The backup sensor reads 8 C below the primary sensor; neither reading is confirmed.\",\n    \"A decision must be made within three minutes.\",\n    \"Further heating can damage equipment.\",\n    \"A controlled shutdown causes a direct loss of EUR 75000.\"\n  ],\n  \"main_objection\": \"Immediate shutdown incurs a guaranteed financial loss, while continuing production risks unquantified technical damage due to sensor uncertainty.\",\n  \"option_id\": \"factory_verify\",\n  \"uncertainty\": \"The correct sensor is unknown and the current state of equipment damage is unknown, making it unclear if the temperature rise has already reached critical levels.\",\n  \"unknowns\": [\n    \"Which sensor is correct is unknown.\",\n    \"Whether equipment is already damaged is unknown.\"\n  ],\n  \"utility_structure\": [\n    \"factory_shutdown: High financial cost, low technical risk\",\n    \"factory_verify: Moderate time cost, potential for informed decision\",\n    \"factory_continue: No immediate financial cost, high technical risk\"\n  ]\n}",
